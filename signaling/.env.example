# Configure only on the signaling host. Never commit real values.
NEXUS_PUBLIC_WSS_URL=wss://YOUR-SERVER.example/ws
NEXUS_PAIRING_ADMIN_TOKEN=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET

# Optional relay settings to embed in pairing QR payloads.
# NEXUS_TURN_URL=turn:YOUR-TURN.example:3478?transport=udp
# NEXUS_TURN_USERNAME=TEMPORARY_TURN_USERNAME
# NEXUS_TURN_CREDENTIAL=TEMPORARY_TURN_CREDENTIAL
