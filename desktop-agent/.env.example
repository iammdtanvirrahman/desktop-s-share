# This file is stored locally at ~/.config/nexus-remote/agent.env.
# Do not commit your real tokens to GitHub.

# Public WSS endpoint of your NEXUS signaling deployment.
NEXUS_SIGNALING_URL=wss://YOUR-SERVER.example/ws

# Admin token accepted only by POST /api/pairing.
# This must match NEXUS_PAIRING_ADMIN_TOKEN on the signaling server.
NEXUS_PAIRING_ADMIN_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Optional TURN relay credentials. Configure these on the server too if you
# want them included in the QR payload; STUN-only connections may fail behind
# some NATs/firewalls.
# NEXUS_TURN_URL=turn:YOUR-TURN.example:3478?transport=udp
# NEXUS_TURN_USERNAME=TEMPORARY_TURN_USERNAME
# NEXUS_TURN_CREDENTIAL=TEMPORARY_TURN_CREDENTIAL

# View-only mode is the default. In the Laptop app, you can also enable control
# using the local checkbox before generating a QR code.
# NEXUS_ENABLE_REMOTE_INPUT=1
