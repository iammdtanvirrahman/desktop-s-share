# Copy to ~/.config/nexus-remote/agent.env and set private values.
# Use wss:// for a server reachable over the public Internet.
NEXUS_SIGNALING_URL=wss://YOUR-SERVER.example/ws
NEXUS_SIGNALING_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET
NEXUS_ROOM=REPLACE_WITH_A_RANDOM_PRIVATE_ROOM

# Optional TURN server. Use the same endpoint/credentials in the Android viewer.
# NEXUS_TURN_URL=turn:YOUR-TURN.example:3478?transport=udp
# NEXUS_TURN_USERNAME=TEMPORARY_TURN_USERNAME
# NEXUS_TURN_CREDENTIAL=TEMPORARY_TURN_CREDENTIAL

# View-only mode is the default. Uncomment only when you intentionally allow
# your paired phone to control this laptop.
# NEXUS_ENABLE_REMOTE_INPUT=1
